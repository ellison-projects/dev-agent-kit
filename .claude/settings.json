{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\" && \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\" || true"
          }
        ]
      }
    ]
  }
}
