# .env.sample
#
# Environment variables a human needs to set for this kit's scripts and
# workflows to work. Copy to `.env.local` and fill in. Never commit
# the populated file — `.env*.local` is gitignored.
#
# Sourced automatically by `dotenv-flow` in the npm scripts.
#
# Note: Vercel auto-injects build-time vars like VERCEL_ENV,
# VERCEL_GIT_COMMIT_REF, and DATABASE_URL (from the matching Neon
# branch) in preview/production builds — those don't go here.

# ───────────────────────────────────────────────────────────────
# Database
# Used by: scripts/migrate-build.js, scripts/reset-database.js,
#          node-pg-migrate (migrate:up, migrate:down)
# ───────────────────────────────────────────────────────────────

# Local Postgres connection string. For dev sessions bootstrapped by
# .claude/hooks/session-start.sh, this works out of the box:
#   postgresql://postgres:postgres@localhost:5432/<dbname>
DATABASE_URL=

# ───────────────────────────────────────────────────────────────
# Neon
# Used by: scripts/reset-preview-branch.js (in Vercel builds) and
#          .github/workflows/*.yml (when enabled).
# Set in:
#   - Vercel project env vars (so the build can reset preview DBs)
#   - GitHub repo secrets/vars (so the cleanup workflows can run)
# ───────────────────────────────────────────────────────────────

# Neon API key — https://console.neon.tech/app/settings/api-keys
# GitHub: store as `secrets.NEON_API_KEY`.
NEON_API_KEY=

# Neon project ID (not name). Find it in the Neon console URL.
# GitHub: store as `vars.NEON_PROJECT_ID`.
NEON_PROJECT_ID=

# Branch ID of your main/production Neon branch (format: br-xxxx-xxxxxxx).
# Used by scripts/reset-preview-branch.js as the source when resetting
# a preview's DB. Find it in the Neon console → Branches → click main.
NEON_MAIN_BRANCH_ID=
